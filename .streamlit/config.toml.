[theme]
base = "light"
primaryColor = "#27B4EA"
backgroundColor = "#EEF3F9"
secondaryBackgroundColor = "#FFFFFF"
textColor = "#0B1530"

# Letra Jost en toda la app, incluida la tabla de datos
font = "Jost:https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700;800;900&display=swap"

# Esquinas rectas y bordes en tinta (estilo neo brutalista)
baseRadius = "none"
borderColor = "#0B1530"

# Tabla de datos: encabezado azul marino con letra blanca y líneas internas suaves
dataframeHeaderBackgroundColor = "#002D5A"
dataframeHeaderTextColor = "#FFFFFF"
dataframeBorderColor = "#C3D0E2"
